#import <MulleObjC/MulleObjC.h>

#import <MulleObjC/MulleObjCDebug.h>


@interface Foo : MulleObject < MulleAutolockingObjectProtocols>
@end

@implementation Foo
@end

//
// objects is not an AutoreleasePool just a pool of objects to acquire from
// and return...
//
#define max_n_objects    4

static id                      objects[ max_n_objects];
static volatile unsigned int   n_objects ;
mulle_thread_mutex_t           objects_mutex ;


static void   fill_pool( void)
{
   unsigned int   i;

   mulle_thread_mutex_lock( &objects_mutex); 
   for( i = 0; i < max_n_objects; i++)
   {
      if( ! objects[ i])
      {
         objects[ i] = [Foo new];
         ++n_objects ;
      }
   }
   mulle_thread_mutex_unlock( &objects_mutex); 
}


static void   release_pool( void)
{
   unsigned int   i;

   mulle_thread_mutex_lock( &objects_mutex); 
   for( i = 0; i < max_n_objects; i++)
   {
      [objects[ i] release];
      objects[ i] = 0;
   }
   mulle_thread_mutex_unlock( &objects_mutex); 
}


struct id_pair
{
   id   a;
   id   b;
};


static id   _extract_random_object( void)
{
   unsigned int    i;
   id              obj;

   // still locked
   do 
   {
      i = rand() % max_n_objects;
   }
   while( ! objects[ i]);

   obj          = objects[ i];
   objects[ i]  = 0;
   n_objects   -= 1;

   return( obj);
}


static struct id_pair   extract_random_object_pair( void)
{
   unsigned int    i;
   id              obj;
   struct id_pair  pair;

   for(;;)
   {
      mulle_thread_mutex_lock( &objects_mutex); 
      if( n_objects  >= 2)
         break;
      mulle_thread_mutex_unlock( &objects_mutex); 
      mulle_thread_yield();
   }

   pair.a = _extract_random_object();
   pair.b = _extract_random_object();

   mulle_thread_mutex_unlock( &objects_mutex); 

   return( pair);
}


static void  insert_object( id obj)
{
   unsigned int   i;

   assert( obj);

   for(;;)
   {
      mulle_thread_mutex_lock( &objects_mutex); 
      if( n_objects  != max_n_objects )
         break;
      mulle_thread_mutex_unlock( &objects_mutex); 
      mulle_thread_yield();
   }

   // still locked
   for( i = 0; i < max_n_objects; i++)
   {
      if( ! objects[ i])
      {
         objects[ i] = obj;
         ++n_objects ;
         mulle_thread_mutex_unlock( &objects_mutex); 
         return;
      }
   }
   abort();
}


#define n_loops   10
#define max_n_threads  (max_n_objects * 2)


@interface Foo( Test)

- (void) swap:(id) other;
- (void) swapWithObject:(Foo *) other;

@end

// Problem: dadurch daß die locks geshared werden, kann es sein daß die locks
//          von objects [ 2] und objects [ 0] dieselbe ist als auch die von 
//          objects [ 3] und objects [ 1]. So benutzt ein thread pair = 
//          { objects [ 0], objects [ 1] }  und der andere pair = { objects [3], objects [2] }
//          wenn beide gleichzeitig laufen, locked thread 0 erst objects [0] und
//          nebenher thread 1 objects [ 3] (gleiche lock wie objects [ 1]) Dann dead
//          locked thread 0 auf objects [ 1]
//
@implementation Foo( Test)

- (void) swapWithObject:(Foo *) other 
{
   mulle_thread_yield();
   [self shareRecursiveLockWithObject:other];
}

- (void) swap:(id) bar
{
   [bar swapWithObject:self];
   mulle_thread_yield();
}

static inline NSRecursiveLock  *FooGetLock( Foo *foo)
{
   return( foo->__lock);
}

@end


static int   test_thread_main( NSThread *thread, void *index)
{
   unsigned int     i;
   Foo              *foo;
   Foo              *bar;
   struct id_pair   pair;

   for( i = 0; i < n_loops; i++)
   {
      pair = extract_random_object_pair();
      mulle_fprintf( stderr, "%p: > %p(%p) %p(%p)%s\n", mulle_thread_self(), pair.a, FooGetLock( pair.a), 
                                                                          pair.b, FooGetLock( pair.b),
                                                                          FooGetLock( pair.a) == FooGetLock( pair.b) ? " SAME" : "");
      [pair.a swap:pair.b];
      mulle_fprintf( stderr, "%p: < %p(%p) %p(%p)\n", mulle_thread_self(), pair.a, FooGetLock( pair.a), 
                                                                         pair.b, FooGetLock( pair.b));
      insert_object( pair.b);
      insert_object( pair.a);
   }
   return( 0);

   mulle_fprintf( stderr, "%p: done\n", mulle_thread_self());

}


// TODO: check cache growth

int  main( int argc, char *argv[])
{
   Foo            *foo;
   NSThread       *thread[ max_n_threads];
   unsigned int   i;

   mulle_thread_mutex_init( &objects_mutex); 
   {
      fill_pool();

      for( i = 0; i < max_n_threads; i++)
      {
         thread[ i] = [NSThread mulleThreadWithFunction:test_thread_main
                                               argument:(void *) (intptr_t) i + 1];
         [thread[ i] mulleStart];
      }

      for( i = 0; i < max_n_threads; i++)
      {
         [thread[ i] mulleJoin];
         mulle_fprintf( stderr, "joined with %p\n", (void *) (intptr_t) i + 1);
      }
      release_pool();
   }
   mulle_thread_mutex_done( &objects_mutex); 
   mulle_fprintf( stderr, "gone now\n");

   return( 0);
}


